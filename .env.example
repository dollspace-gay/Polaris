# Polaris environment variables. Copy to .env (gitignored) and adjust.
#
# DATABASE_URL — Postgres connection string consumed by polaris-backend at
# startup. Format: postgres://USER:PASS@HOST:PORT/DBNAME.
DATABASE_URL=postgres://polaris:polaris@localhost:5432/polaris

# POLARIS_HTTP_BIND — Listening address for the Axum HTTP server.
# Use 0.0.0.0:8080 inside containers; the safer 127.0.0.1:8080 is the
# development default.
POLARIS_HTTP_BIND=127.0.0.1:8080
