# Agent / tracker state — never project source, never on GitHub
.claude/
.crosslink/
**/.crosslink/

# Rust build artifacts
/target/

# xtask local caches (e.g. `cargo xtask lexicon-contract` fetched
# upstream lexicons keyed by `UPSTREAM_LEXICON_COMMIT`). Cache key is
# the SHA pin, so a bumped pin gets fresh fetches.
/.xtask-cache/

# Editor temporaries
*.swp

# Log files
*.log

# Environment files (never commit secrets)
.env
.env.local

# Temporary files
*.tmp

# Agent worktree state (from /kickoff, /featree flows) — per-developer,
# never project source. Crosslink's .claude managed-block above already
# covers hooks/, commands/, mcp/; this catches the worktrees/ subdir
# which is the bulk (~52 MB on a working repo).

# Per-crate sqlx cache. The canonical offline cache is the workspace-
# root `.sqlx/`; the per-crate copy is a leftover from earlier dev
# iterations. CI uses the workspace cache via SQLX_OFFLINE=true.
polaris-backend/.sqlx/
