  "query": "\n            SELECT id, seq, src, uri, cid, val, neg, cts, exp, sig,\n                   subject_did, label_cbor, signing_did, signed_at\n            FROM labels\n            WHERE subject_did = $1\n            ORDER BY signed_at DESC\n            LIMIT $2\n            ",
