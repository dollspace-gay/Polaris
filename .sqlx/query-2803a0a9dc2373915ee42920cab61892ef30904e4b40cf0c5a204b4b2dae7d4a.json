{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            il.src,\n            il.uri,\n            il.cid,\n            il.val,\n            il.neg,\n            il.cts,\n            il.exp,\n            lp.display_name AS \"display_name?\",\n            lp.handle       AS \"handle?\"\n        FROM indexed_labels il\n        LEFT JOIN labeler_profiles lp ON lp.did = il.src\n        WHERE il.uri = $1 OR il.uri LIKE $2 || '%'\n        ORDER BY il.cts DESC\n        ",
