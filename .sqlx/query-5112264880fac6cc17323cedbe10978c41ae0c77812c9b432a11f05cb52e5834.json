  "query": "\n            SELECT id, subject_id, incident_id, reporter_did, category, body, created_at\n            FROM reports\n            WHERE subject_id = $1\n              AND actioned_at IS NULL\n            ORDER BY created_at DESC\n            LIMIT $2\n            ",
