  "query": "\n        INSERT INTO subject_tags (subject_id, tag, applied_by)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (subject_id, tag) DO UPDATE\n        SET applied_by = EXCLUDED.applied_by,\n            applied_at = now()\n        RETURNING tag, applied_by, applied_at\n        ",
