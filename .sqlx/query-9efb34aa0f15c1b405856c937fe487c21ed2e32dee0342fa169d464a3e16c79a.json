  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, primary_subject, severity, status, assigned_to, locked_by,\n                   opened_at, closed_at\n            FROM incidents\n            WHERE $1::text IS NULL OR status = $1\n            ORDER BY opened_at DESC\n            LIMIT $2\n            ",
