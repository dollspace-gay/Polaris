# Polaris labeler-profile environment template.
#
# 1. cp .env.example .env
# 2. Replace every <placeholder> with a real value.
# 3. Anything marked `# SECRET — do not commit` MUST be generated locally
#    (never copy from a shared doc). The `.env` file MUST stay out of
#    version control (the repo `.gitignore` already excludes it).
#
# Each variable is documented with the polaris-backend AppConfig field it
# drives (polaris-backend/src/config.rs). Unset variables fall back to
# the documented default; required variables (those without a defensive
# default) are marked REQUIRED.
#
# ────────────────────────────────────────────────────────────────────────
# Public deployment identity
# ────────────────────────────────────────────────────────────────────────

# REQUIRED. Public DNS hostname Polaris serves on. Drives Caddy TLS
# (Let's Encrypt) and the OAuth client_id / redirect_uri exposed to
# moderators. No scheme, no port (Caddy adds https://).
POLARIS_HOSTNAME=<your-domain>

# Optional. Override the polaris-backend image tag pulled from
# ghcr.io/dollspace-gay/polaris-backend. Defaults to `latest`,
# which tracks the tip of the upstream `main` branch. Pin to a
# specific `vX.Y.Z` for reproducible upgrades, e.g.:
#   POLARIS_IMAGE_TAG=v0.6.0
# Leave unset (or `=latest`) to get the rolling release.
# POLARIS_IMAGE_TAG=latest

# ────────────────────────────────────────────────────────────────────────
# Postgres
# ────────────────────────────────────────────────────────────────────────

# Internal Postgres credentials. The compose stack composes DATABASE_URL
# from these values; an external managed Postgres operator should leave
# these unset and instead set DATABASE_URL directly below.
POSTGRES_USER=polaris
POSTGRES_DB=polaris
# SECRET — do not commit. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-24>

# Optional. If set, this overrides the compose-internal DATABASE_URL
# composition (useful for pointing Polaris at managed Postgres). Format:
#   postgres://user:password@host:5432/dbname
# Default (unset): composed from the three POSTGRES_* values above.
# DATABASE_URL=postgres://polaris:polaris@postgres:5432/polaris

# ────────────────────────────────────────────────────────────────────────
# HTTP listener
# ────────────────────────────────────────────────────────────────────────

# Bind address. Default 127.0.0.1:8080 (loopback-only). The compose stack
# overrides this to 0.0.0.0:8080 inside the container so Caddy can reach
# the backend over polaris-net.
# POLARIS_HTTP_BIND=0.0.0.0:8080

# ────────────────────────────────────────────────────────────────────────
# Deployment profile (issue #29 / AC-14)
# ────────────────────────────────────────────────────────────────────────

# `labeler` (default, self-hosted) or `bluesky` (first-party multi-region).
# The bluesky profile refuses to boot with file-plain signing-key custody;
# operators on file-plain MUST stay on `labeler` until they migrate to
# os-keychain, passphrase-sealed, or cloud-kms-oracle.
POLARIS_PROFILE=labeler

# ────────────────────────────────────────────────────────────────────────
# Session crypto (issue #9)
# ────────────────────────────────────────────────────────────────────────

# SECRET — do not commit. 32-byte AES-256-GCM key for refresh-token-at-rest
# encryption, 64 lowercase hex chars. Generate with:
#   openssl rand -hex 32
# The binary refuses to boot against a zero key (SecurityConfig::ensure_non_zero).
POLARIS_COOKIE_KEY=<openssl-rand-hex-32>

# ────────────────────────────────────────────────────────────────────────
# Moderator authentication backend (issue #9 / #31)
# ────────────────────────────────────────────────────────────────────────

# `oidc` (default) or `atproto`. Both subsystems compile in; this picks
# the runtime verifier.
POLARIS_AUTH_BACKEND=oidc

# --- OIDC backend (when POLARIS_AUTH_BACKEND=oidc) ---
# Issuer URL — discovery hits {issuer_url}/.well-known/openid-configuration.
POLARIS_OIDC_ISSUER_URL=https://accounts.example.com
POLARIS_OIDC_CLIENT_ID=<your-oidc-client-id>
# SECRET — do not commit.
POLARIS_OIDC_CLIENT_SECRET=<your-oidc-client-secret>
# Where the IdP redirects after login. Must match the registered
# redirect URI in your IdP console.
POLARIS_OIDC_REDIRECT_URL=https://<your-domain>/auth/oidc/callback

# --- ATProto OAuth backend (when POLARIS_AUTH_BACKEND=atproto) ---
# Filesystem path (inside the container) to the OAuth client metadata
# JSON. Mount the file in via the compose volume layer.
# POLARIS_ATPROTO_CLIENT_METADATA=/etc/polaris/client_metadata.json
# Public client_id URL — must match `client_id` inside the JSON document
# AND be served from the same host (proto-blue rejects mismatches).
# POLARIS_ATPROTO_CLIENT_ID=https://<your-domain>/oauth/client-metadata.json

# ────────────────────────────────────────────────────────────────────────
# Labeler signing-key custody (issue #29 / REQ-11 / AC-13)
# ────────────────────────────────────────────────────────────────────────

# One of: file-plain, passphrase-sealed, os-keychain, cloud-kms-oracle.
# Default file-plain (Ozone-equivalent posture) — emits a startup WARN.
POLARIS_LABELER_SIGNING_KEY_MODE=file-plain

# --- file-plain / passphrase-sealed (path on disk to the key blob) ---
POLARIS_LABELER_SIGNING_KEY_PATH=/etc/polaris/keys/labeler.key

# --- passphrase-sealed only ---
# SECRET — do not commit. The unseal passphrase, also readable from stdin
# if this is unset (`docker compose exec polaris-backend` with a TTY).
# POLARIS_SIGNING_PASSPHRASE=<your-unseal-passphrase>

# --- os-keychain only ---
# Operator-side account name under the `polaris.labeler` service.
# POLARIS_LABELER_SIGNING_KEY_ACCOUNT=<your-account-id>

# --- cloud-kms-oracle only ---
# Provider: aws (wired), gcp (stub), azure (stub).
# POLARIS_LABELER_SIGNING_KEY_KMS_PROVIDER=aws
# POLARIS_LABELER_SIGNING_KEY_KMS_KEY_ID=<arn-of-your-kms-key>
# POLARIS_LABELER_SIGNING_KEY_KMS_REGION=us-east-1

# ────────────────────────────────────────────────────────────────────────
# Pattern-action senior co-sign threshold (issue #21)
# ────────────────────────────────────────────────────────────────────────

# Auto-approve pattern actions affecting at most N subjects; anything
# larger requires senior co-sign. Default 100.
# POLARIS_PATTERN_ACTIONS_COSIGN_THRESHOLD=100

# ────────────────────────────────────────────────────────────────────────
# Evidence-preservation worker (issue #33)
# ────────────────────────────────────────────────────────────────────────

# Blob-store backend: `in-memory` (default; tests only), `local-fs`
# (recommended for labeler profile), or `s3` (Bluesky profile / shared
# cluster).
POLARIS_EVIDENCE_BLOB_STORE=local-fs

# local-fs root directory. The compose stack mounts the
# polaris-evidence named volume here.
POLARIS_EVIDENCE_LOCAL_FS_ROOT=/var/lib/polaris/evidence

# s3 backend (when POLARIS_EVIDENCE_BLOB_STORE=s3). The aws-sdk-s3
# client reads credentials from the AWS SDK default chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / IMDSv2 / etc.).
# POLARIS_EVIDENCE_S3_BUCKET=<your-bucket>
# POLARIS_EVIDENCE_S3_REGION=us-east-1

# Worker tuning. Defaults: 4 in-flight fetches, 5s poll interval when
# the queue is empty.
# POLARIS_EVIDENCE_WORKER_CONCURRENCY=4
# POLARIS_EVIDENCE_POLL_INTERVAL_SECS=5

# ────────────────────────────────────────────────────────────────────────
# AWS SDK (when POLARIS_EVIDENCE_BLOB_STORE=s3 or signing-key mode is
# cloud-kms-oracle). The aws-config crate reads these directly; Polaris
# never parses them — they exist here as commented stubs so the operator
# sees them in one place.
# ────────────────────────────────────────────────────────────────────────

# SECRET — do not commit.
# AWS_ACCESS_KEY_ID=<your-access-key-id>
# SECRET — do not commit.
# AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
# AWS_REGION=us-east-1

# ────────────────────────────────────────────────────────────────────────
# LLM moderation-assist (optional, off by default)
#
# Polaris consumes an LLM-backed `Recommend` RPC on the same gRPC
# surface as the classifier substrate (proto/polaris-classifier-v1.proto).
# When unconfigured, the dispatcher is `None` on the API state and
# every LLM-related code path is a no-op — the deployment behaves as
# a pure human-moderation labeler.
#
# Enabling the substrate requires two things together:
#
#   1. A gRPC server implementing `polaris.classifier.v1.Classifier`
#      reachable from the polaris-backend container. The shipped
#      `examples/llm-fixture-adapter/` is the wire-up validation
#      target; `examples/llm-prompt-reference/` shows the Python
#      prompt shape for a real model (Qwen 2.5 32B Instruct).
#
#   2. The polaris-backend binary's env-var driven dispatcher
#      installation. The full feature set (dispatcher, safety floors,
#      audit page, dry-run, kill switch, fixture) is implemented on
#      main today; the remaining glue is the boot-time wiring that
#      reads the variables below and calls
#      `ApiState::with_llm_dispatcher(...)` against a configured
#      `TonicClassifierClient`. Until that wiring lands, the variables
#      below are documentation of the contract — set them now and
#      they will activate the substrate the moment the wiring ships.
#
# Operator runbook: docs/ops/llm-moderation.md
# Safety floors + autonomy invariants: docs/ops/policy-autonomy.md
# ────────────────────────────────────────────────────────────────────────

# Endpoint of the gRPC LLM adapter. Must implement the `Recommend` and
# `HealthCheck` RPCs at minimum. No scheme other than `http://` or
# `https://`; the tonic channel parses TLS configuration from the URL.
# POLARIS_LLM_ENDPOINT=http://llm-adapter:50052

# Per-call timeout for `Recommend`. LLM inference is slower than the
# classify RPC's 500ms; the design's default (REQ-A5) is 15s.
# POLARIS_LLM_RECOMMEND_TIMEOUT_MS=15000

# Surface a "this case was scored by an external classifier `<name>`"
# banner in the case-view. Required (`true`) when the adapter forwards
# events to a third-party cloud API (Anthropic, OpenAI, Bedrock, …).
# Set `false` only when the adapter and model run inside the operator's
# own network boundary. See docs/ops/classifier-integration.md § 4.
# POLARIS_LLM_EXTERNAL=false

# Human-readable name surfaced in the audit envelope and the case-view
# external-classifier banner. Defaults to "llm" when unset.
# POLARIS_LLM_NAME=llm-primary

# Enable feedback delivery (reversal / assisted-reject / 24h-confirmation
# `Feedback` RPCs). Off by default; turn on once the adapter's feedback
# pipeline (RAG corpus / fine-tuning queue / SFT job) is ready to
# consume the signal. The feedback payload is privacy-bounded —
# moderator identity and reasoning text never cross the wire (REQ-G4).
# POLARIS_LLM_SEND_FEEDBACK=false
