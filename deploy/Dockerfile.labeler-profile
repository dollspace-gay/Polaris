# Polaris labeler-profile container image.
#
# Two-stage build:
#   1. `build`   — rust:alpine cross-toolchain compiles polaris-backend.
#   2. runtime   — alpine:3.20 with ca-certificates + a non-root user.
#
# Why alpine-glibc-runtime (not `FROM scratch`)? The labeler profile
# prioritises operator debuggability: a self-hosted operator hitting a
# weird failure benefits from being able to `docker exec -it ... sh`
# into the running container. The Bluesky-profile image
# (Dockerfile.bluesky-profile) is the FROM-scratch musl-static variant
# for production fleets where image size and attack surface dominate.
#
# Image size budget (informational): under 80 MB. The bluesky-profile
# image is the size-constrained one (≤ 50 MB).

# ── Stage 1: build ────────────────────────────────────────────────────
FROM rust:1.88-alpine3.20 AS build

# musl-dev is the C toolchain; openssl-dev + pkgconfig back any sys-crate
# in the workspace that links against OpenSSL transitively (proto-blue's
# rustls posture means this is not strictly required today, but pinning
# the toolchain layer is cheaper than fighting a missing-symbol error
# downstream). git is required by some build-script dependencies.
RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconfig git

WORKDIR /app

# Copy the workspace manifests + sources for ALL nine workspace
# members. Cargo validates every workspace member's Cargo.toml paths
# (the `[lib] path = ...` and `[bin] path = ...` fields) when
# resolving the workspace — including for crates the target binary
# doesn't depend on. Manifest-only stubs would fail validation. The
# build stage is discarded after stage 2, so a larger build context
# costs nothing in the final image.
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY polaris-types polaris-types
COPY polaris-backend polaris-backend
COPY polaris-frontend polaris-frontend
COPY polaris-lexicons polaris-lexicons
COPY polaris-classifier-proto polaris-classifier-proto
COPY polaris-trust polaris-trust
COPY polaris-publish-labeler-record polaris-publish-labeler-record
COPY polaris-publish-did-service polaris-publish-did-service
COPY xtask xtask

# The `polaris-classifier-proto` crate's build.rs reads
# `../proto/polaris-classifier-v1.proto` at compile time (tonic-prost
# codegen). Without copying the root `proto/` tree the build aborts
# with `protoc failed: Could not make proto path relative` — see the
# publish-image failure on commit 89a7b5d0. The proto directory is
# small (~10 KB) so copying it unconditionally has no measurable cost.
COPY proto proto

# Build the backend binary. The release profile is the workspace
# default; LTO and codegen-units are tuned in the workspace Cargo.toml.
# We do NOT build polaris-frontend here — the wasm bundle is a separate
# CI job (cargo + trunk) whose output is copied into the runtime stage
# below by the operator's CI pipeline (or burned in via a later issue).
RUN cargo build --release --locked -p polaris-backend --bin polaris-backend

# ── Stage 2: runtime ──────────────────────────────────────────────────
FROM alpine:3.20

# ca-certificates: required for the rustls TLS stack (OIDC discovery,
# proto-blue agent calls, S3 SDK). tini: PID-1 signal handler so
# `docker stop` propagates SIGTERM cleanly to the backend.
RUN apk add --no-cache ca-certificates tini \
    && addgroup -S -g 1000 polaris \
    && adduser -S -u 1000 -G polaris polaris \
    && mkdir -p /var/lib/polaris/evidence /etc/polaris/keys \
    && chown -R polaris:polaris /var/lib/polaris /etc/polaris

COPY --from=build /app/target/release/polaris-backend /usr/local/bin/polaris-backend

USER 1000:1000
WORKDIR /var/lib/polaris

EXPOSE 8080

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/polaris-backend"]
