# Example: how to materialise the `polaris-secrets` Secret out-of-band.
#
# This file is NOT a Helm template — committing a Secret manifest with
# real values to the chart would defeat the point. Instead, run the
# kubectl commands below against your live cluster before `helm install`.
#
# ────────────────────────────────────────────────────────────────────────
# Option A: kubectl create secret generic (single command, suits dev)
# ────────────────────────────────────────────────────────────────────────
#
#   POLARIS_COOKIE_KEY=$(openssl rand -hex 32)
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
#   REDIS_PASSWORD=$(openssl rand -hex 24)
#
#   kubectl -n polaris create secret generic polaris-secrets \
#     --from-literal=POLARIS_COOKIE_KEY="$POLARIS_COOKIE_KEY" \
#     --from-literal=POSTGRES_PASSWORD="$POSTGRES_PASSWORD" \
#     --from-literal=POSTGRES_ADMIN_PASSWORD="$POSTGRES_PASSWORD" \
#     --from-literal=REDIS_PASSWORD="$REDIS_PASSWORD" \
#     --from-literal=DATABASE_URL="postgres://polaris:${POSTGRES_PASSWORD}@polaris-postgresql:5432/polaris" \
#     --from-literal=POLARIS_LABELER_SIGNING_KEY_MODE="cloud-kms-oracle" \
#     --from-literal=POLARIS_LABELER_SIGNING_KEY_KMS_PROVIDER="aws" \
#     --from-literal=POLARIS_LABELER_SIGNING_KEY_KMS_KEY_ID="<arn-of-your-kms-key>" \
#     --from-literal=POLARIS_LABELER_SIGNING_KEY_KMS_REGION="us-east-1" \
#     --from-literal=POLARIS_OIDC_ISSUER_URL="https://accounts.example.com" \
#     --from-literal=POLARIS_OIDC_CLIENT_ID="<your-oidc-client-id>" \
#     --from-literal=POLARIS_OIDC_CLIENT_SECRET="<your-oidc-client-secret>" \
#     --from-literal=POLARIS_OIDC_REDIRECT_URL="https://polaris.example.com/auth/oidc/callback" \
#     --from-literal=POLARIS_EVIDENCE_S3_BUCKET="<your-evidence-bucket>" \
#     --from-literal=POLARIS_EVIDENCE_S3_REGION="us-east-1" \
#     --from-literal=AWS_ACCESS_KEY_ID="<your-access-key>" \
#     --from-literal=AWS_SECRET_ACCESS_KEY="<your-secret-key>" \
#     --from-literal=AWS_REGION="us-east-1"
#
# ────────────────────────────────────────────────────────────────────────
# Option B: external-secrets-operator (recommended for production)
# ────────────────────────────────────────────────────────────────────────
#
# Install external-secrets, create an `ExternalSecret` resource that
# pulls polaris-secrets from your secret store (AWS Secrets Manager,
# GCP Secret Manager, HashiCorp Vault, etc.). The chart references the
# Secret by name (polaris.envFromSecret in values.yaml) so the source
# is opaque to the chart.
#
# ────────────────────────────────────────────────────────────────────────
# Option C: SealedSecrets (committable encrypted manifest)
# ────────────────────────────────────────────────────────────────────────
#
# Install bitnami/sealed-secrets and run:
#
#   kubectl create secret generic polaris-secrets ... --dry-run=client -o yaml \
#     | kubeseal -o yaml > polaris-secrets.sealed.yaml
#
# Commit polaris-secrets.sealed.yaml. The controller materialises the
# Secret on apply.
#
# ────────────────────────────────────────────────────────────────────────
#
# Once the Secret exists in the polaris namespace, install/upgrade the
# chart:
#
#   helm upgrade --install polaris . -n polaris -f values.yaml
#
# Verify pod startup:
#
#   kubectl -n polaris rollout status deploy/polaris
#   kubectl -n polaris exec deploy/polaris -- wget -qO- http://localhost:8080/healthz
